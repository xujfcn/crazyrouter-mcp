{
  "type": "hosted",
  "stateful": false,
  "hasAuthAdapter": false,
  "serverCard": {
    "serverInfo": {
      "name": "crazyrouter",
      "version": "1.0.1"
    },
    "tools": [
      {
        "name": "chat",
        "description": "Send text messages to a model supporting Chat Completions. Model-specific parameter limits apply.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "default": "gpt-4o-mini"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "system",
                      "user",
                      "assistant"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "role",
                  "content"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "max_completion_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "messages"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "list_models",
        "description": "List models returned for your key. Categories use public endpoint metadata; discovery does not imply this MCP implements every model protocol.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "chat",
                "image",
                "video",
                "audio",
                "music",
                "other"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "generate_image",
        "description": "Generate one image using a model listed for /v1/images/generations. Returns a URL or a base64 image. Midjourney and video task APIs are not supported by this tool.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "default": "gpt-image-2"
            },
            "size": {
              "type": "string"
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      }
    ],
    "resources": [],
    "prompts": []
  }
}
